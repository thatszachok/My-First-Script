    corner(10, pillBg)
    stroke(1, T.border, pillBg)
 
    local pillDot = Instance.new("Frame")
    pillDot.Size             = UDim2.new(0, 14, 0, 14)
    pillDot.Position         = UDim2.new(0, 3, 0.5, -7)
    pillDot.BackgroundColor3 = T.textMuted
    pillDot.BorderSizePixel  = 0
    pillDot.Parent           = pillBg
    corner(7, pillDot)
 
    local sep = Instance.new("Frame")
    sep.Size             = UDim2.new(1, -16, 0, 1)
    sep.Position         = UDim2.new(0, 8, 1, -1)
    sep.BackgroundColor3 = T.border
    sep.BackgroundTransparency = 0.4
    sep.BorderSizePixel  = 0
    sep.Parent           = row
 
    local clickBtn = Instance.new("TextButton")
    clickBtn.Size             = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text             = ""
    clickBtn.AutoButtonColor  = false
    clickBtn.Parent           = row
 
    local function setState(val)
        active = val
        tween(bar,     {BackgroundTransparency = val and 0 or 1},    0.15)
        tween(txt,     {TextColor3 = val and T.white or T.text},     0.15)
        tween(pillBg,  {BackgroundColor3 = val and accent or T.bg4}, 0.15)
        tween(pillDot, {
            Position         = val and UDim2.new(0, 21, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = val and T.white or T.textMuted,
        }, 0.15)
        if val then
            tween(row, {BackgroundColor3 = T.bg2}, 0.15)
        else
            tween(row, {BackgroundColor3 = T.bg1}, 0.15)
        end
        if onToggle then onToggle(val) end
    end
 
    clickBtn.MouseEnter:Connect(function()
        if not active then tween(row, {BackgroundColor3=T.bg2}, 0.1) end
    end)
    clickBtn.MouseLeave:Connect(function()
        if not active then tween(row, {BackgroundColor3=T.bg1}, 0.1) end
    end)
    clickBtn.MouseButton1Click:Connect(function() setState(not active) end)
 
    return setState
end
 
