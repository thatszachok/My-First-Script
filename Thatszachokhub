    header.BorderSizePixel  = 0
    header.Parent           = page

    local hTxt = Instance.new("TextLabel")
    hTxt.Size               = UDim2.new(1,-40,1,0)
    hTxt.Position           = UDim2.new(0,12,0,0)
    hTxt.BackgroundTransparency = 1
    hTxt.TextColor3         = T.textDim
    hTxt.Text               = navIcon .. "  " .. string.upper(navLabel)
    hTxt.Font               = Enum.Font.GothamBold
    hTxt.TextSize           = 11
    hTxt.TextXAlignment     = Enum.TextXAlignment.Left
    hTxt.Parent             = header

    local hLine = Instance.new("Frame")
    hLine.Size             = UDim2.new(1,0,0,1)
    hLine.Position         = UDim2.new(0,0,1,0)
    hLine.BackgroundColor3 = T.border
    hLine.BorderSizePixel  = 0
    hLine.Parent           = header

    -- Scrollable item list
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size                   = UDim2.new(1,0,1,-41)
    scroll.Position               = UDim2.new(0,0,0,41)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness     = 2
    scroll.ScrollBarImageColor3   = T.accent
    scroll.CanvasSize             = UDim2.new(0,0,0,0)
    scroll.AutomaticCanvasSize    = Enum.AutomaticSize.Y
    scroll.BorderSizePixel        = 0
    scroll.Parent                 = page

    local itemLayout = Instance.new("UIListLayout")
    itemLayout.Padding    = UDim.new(0,0)
    itemLayout.SortOrder  = Enum.SortOrder.LayoutOrder
    itemLayout.Parent     = scroll

    -- Sidebar nav button
    local navBtn = Instance.new("TextButton")
    navBtn.Size             = UDim2.new(1,0,0,36)
    navBtn.BackgroundTransparency = 1
    navBtn.Text             = ""
    navBtn.AutoButtonColor  = false
    navBtn.LayoutOrder      = layoutOrder
    navBtn.Parent           = navList

    local accentBar = Instance.new("Frame")
    accentBar.Size             = UDim2.new(0,3,0,18)
    accentBar.Position         = UDim2.new(0,0,0.5,-9)
    accentBar.BackgroundColor3 = T.accent
    accentBar.BorderSizePixel  = 0
    accentBar.BackgroundTransparency = 1
    accentBar.Parent           = navBtn
    corner(2, accentBar)

    local navLbl = lbl(navIcon .. "  " .. navLabel, 12, Enum.Font.Gotham, T.textDim, navBtn)
    navLbl.Size     = UDim2.new(1,-10,1,0)
    navLbl.Position = UDim2.new(0,10,0,0)

    local tab = {navBtn=navBtn, accentBar=accentBar, navLbl=navLbl, page=page, scroll=scroll}
    table.insert(tabs, tab)

    navBtn.MouseEnter:Connect(function()
        if activeTab ~= tab then
            tween(navBtn, {BackgroundTransparency=0.9}, 0.1)
        end
    end)
    navBtn.MouseLeave:Connect(function()
        if activeTab ~= tab then
            tween(navBtn, {BackgroundTransparency=1}, 0.1)
        end
    end)

    navBtn.MouseButton1Click:Connect(function()
        if activeTab == tab then return end
        -- deactivate old
        if activeTab then
            activeTab.page.Visible = false
            tween(activeTab.accentBar, {BackgroundTransparency=1}, 0.15)
            tween(activeTab.navLbl, {TextColor3=T.textDim}, 0.15)
            tween(activeTab.navBtn, {BackgroundTransparency=1}, 0.15)
        end
        -- activate new
        activeTab = tab
        tab.page.Visible = true
        tab.page.Position = UDim2.new(0.05,0,0,0)
        tween(tab.page, {Position=UDim2.new(0,0,0,0)}, 0.18, Enum.EasingStyle.Quart)
        tween(tab.accentBar, {BackgroundTransparency=0}, 0.15)
        tween(tab.navLbl, {TextColor3=T.white}, 0.15)
        tween(tab.navBtn, {BackgroundTransparency=0.88}, 0.15)
    end)

    return scroll
end

