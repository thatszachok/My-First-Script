-- ============================================================
-- OPEN / CLOSE ANIMATION
-- ============================================================
local panelOpen = false

local function openPanel()
    panelOpen = true; panel.Visible = true
    panel.Size = UDim2.new(0, PANEL_W, 0, 0)
    tween(panel, {Size=UDim2.new(0,PANEL_W,0,PANEL_H)}, 0.25, Enum.EasingStyle.Back)
end
local function closePanel()
    panelOpen = false
    tween(panel, {Size=UDim2.new(0,PANEL_W,0,0)}, 0.2, Enum.EasingStyle.Quart)
    task.delay(0.21, function() if not panelOpen then panel.Visible=false end end)
end

toggleBtn.MouseButton1Click:Connect(function()
    if panelOpen then closePanel() else openPanel() end
end)
closeBtn.MouseButton1Click:Connect(closePanel)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.F4 then
        if panelOpen then closePanel() else openPanel() end
    end
end)

