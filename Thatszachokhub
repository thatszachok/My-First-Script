-- ---- helper: collect all themed objects so we can repaint ----
-- We push references into these tables as we build the UI tab
-- then applyTheme() iterates them.
 
-- applyTheme: push a preset into T and repaint core UI elements
local function applyTheme(preset)
    T.accent    = preset.accent
    T.accentDim = preset.accentDim
    T.accentHi  = preset.accentHi
    T.bg0       = preset.bg0
    T.bg1       = preset.bg1
    T.bg2       = preset.bg2
    T.bg4       = preset.bg4
    T.border    = preset.border
    T.textDim   = preset.textDim
    T.textMuted = preset.textMuted
 
    -- panel chrome
    tween(panel,       {BackgroundColor3 = T.bg0},   0.25)
    tween(topBar,      {BackgroundColor3 = T.bg1},   0.25)
    tween(navBar,      {BackgroundColor3 = T.bg1},   0.25)
    tween(topLine,     {BackgroundColor3 = T.border},0.25)
    tween(navBarLine,  {BackgroundColor3 = T.border},0.25)
    tween(panelStroke, {Color = T.border},           0.25)
 
    -- toggle button
    tween(toggleBtn,    {BackgroundColor3 = T.bg1},  0.25)
    tween(toggleBtn,    {TextColor3       = T.accent},0.25)
    tween(toggleStroke, {Color            = T.accent},0.25)
 
    -- scroll bar tint on all sections
    for _, t in ipairs(tabs) do
        t.scroll.ScrollBarImageColor3 = T.accent
        tween(t.underline, {BackgroundColor3 = T.accent}, 0.25)
        if activeTab == t then
            tween(t.textLbl, {TextColor3 = T.accent}, 0.25)
            tween(t.iconLbl, {TextColor3 = T.accent}, 0.25)
        else
            tween(t.textLbl, {TextColor3 = T.textDim}, 0.25)
            tween(t.iconLbl, {TextColor3 = T.textDim}, 0.25)
        end
    end
 
    -- repaint every row inside every section scroll
    for _, t in ipairs(tabs) do
        for _, child in ipairs(t.scroll:GetDescendants()) do
            if child:IsA("Frame") then
                -- bg rows
                if child.BackgroundColor3 == T.bg1 or child.BackgroundColor3 == T.bg2 then
                    -- leave individual hover states; just tint bg0 dividers
                end
            elseif child:IsA("TextLabel") then
                if child.TextColor3 == T.textMuted then
                    tween(child, {TextColor3 = T.textMuted}, 0.25)
                end
            end
        end
    end
 
    -- tpBtn accent
    tween(tpBtn, {BackgroundColor3 = T.accent}, 0.25)
end
 
