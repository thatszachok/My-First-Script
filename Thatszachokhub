-- ESP
local espHL, espBills = {}, {}
local espDistConn

local function removeESPForPlayer(p)
    local uid = p.UserId
    if espHL[uid] and espHL[uid].Parent then espHL[uid]:Destroy() end
    if espBills[uid] and espBills[uid].Parent then espBills[uid]:Destroy() end
    espHL[uid]=nil; espBills[uid]=nil
end

local function buildESPForChar(p, char)
    if p == player then return end
    local uid = p.UserId
    if espHL[uid] and espHL[uid].Parent then espHL[uid]:Destroy() end
    local h = Instance.new("Highlight")
    h.Adornee=char; h.FillColor=Color3.fromRGB(138,80,255)
    h.OutlineColor=Color3.fromRGB(200,150,255)
    h.FillTransparency=0.5; h.OutlineTransparency=0
    h.Parent=char; espHL[uid]=h

    if espBills[uid] and espBills[uid].Parent then espBills[uid]:Destroy() end
    local head = char:WaitForChild("Head",5); if not head then return end
    local bb = Instance.new("BillboardGui")
    bb.Name="TZespBB"; bb.Adornee=head
    bb.Size=UDim2.new(0,140,0,44); bb.StudsOffset=Vector3.new(0,2.5,0)
    bb.AlwaysOnTop=true; bb.MaxDistance=800; bb.ResetOnSpawn=false
    bb.Parent=char; espBills[uid]=bb

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size=UDim2.new(1,0,0,22); nameLbl.BackgroundTransparency=1
    nameLbl.TextColor3=Color3.fromRGB(200,150,255)
    nameLbl.Text=p.DisplayName.." (@"..p.Name..")"
    nameLbl.Font=Enum.Font.GothamBold; nameLbl.TextSize=13
    nameLbl.TextStrokeTransparency=0.4; nameLbl.Parent=bb

    local distLbl = Instance.new("TextLabel")
    distLbl.Name="DistLbl"; distLbl.Size=UDim2.new(1,0,0,18)
    distLbl.Position=UDim2.new(0,0,0,22); distLbl.BackgroundTransparency=1
    distLbl.TextColor3=Color3.fromRGB(180,220,255)
    distLbl.Font=Enum.Font.Gotham; distLbl.TextSize=11
    distLbl.TextStrokeTransparency=0.3; distLbl.Parent=bb
end

local function toggleESP(on)
    state.esp = on
    if not on then
        for _, p in ipairs(Players:GetPlayers()) do removeESPForPlayer(p) end
        clearConn("espAdded"); return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then buildESPForChar(p, p.Character) end
    end
    connections.espAdded = Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(c)
            if state.esp then buildESPForChar(p,c) end
        end)
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            p.CharacterAdded:Connect(function(c)
                if state.esp then buildESPForChar(p,c) end
            end)
        end
    end
    if not espDistConn then
        espDistConn = RunService.Heartbeat:Connect(function()
            if not state.esp then return end
            local myChar = player.Character
            local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    local bb = espBills[p.UserId]
                    if bb and bb.Parent then
                        local dl = bb:FindFirstChild("DistLbl")
                        local pHRP = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                        if dl and myHRP and pHRP then
                            local dist = math.floor((myHRP.Position-pHRP.Position).Magnitude)
                            dl.Text = dist.." studs"
                            dl.TextColor3 = dist<50 and Color3.fromRGB(80,220,120)
                                or dist<150 and Color3.fromRGB(255,185,45)
                                or Color3.fromRGB(255,100,100)
                        end
                    end
                end
            end
        end)
    end
end

