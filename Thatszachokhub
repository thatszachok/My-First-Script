local hitboxSize    = 10
local originalSizes = {}
local function applyHitboxes()
    originalSizes = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                originalSizes[hrp] = hrp.Size
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            end
        end
    end
end
local function removeHitboxes()
    for part, origSize in pairs(originalSizes) do
        if part and part.Parent then part.Size = origSize end
    end
    originalSizes = {}
end
local function toggleHitbox(on)
    state.hitbox = on; clearConn("hitbox")
    if on then
        applyHitboxes()
        connections.hitbox = Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function(char)
                if not state.hitbox then return end
                task.wait(0.5)
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then originalSizes[hrp]=hrp.Size; hrp.Size=Vector3.new(hitboxSize,hitboxSize,hitboxSize) end
            end)
        end)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                p.CharacterAdded:Connect(function(char)
                    if not state.hitbox then return end
                    task.wait(0.5)
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then originalSizes[hrp]=hrp.Size; hrp.Size=Vector3.new(hitboxSize,hitboxSize,hitboxSize) end
                end)
            end
        end
    else
        removeHitboxes()
    end
end
local function setHitboxSize(v)
    hitboxSize = v
    if state.hitbox then
        for part in pairs(originalSizes) do
            if part and part.Parent then part.Size = Vector3.new(v,v,v) end
        end
    end
end
 
