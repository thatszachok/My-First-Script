    local navInnerLayout = Instance.new("UIListLayout")
    navInnerLayout.FillDirection  = Enum.FillDirection.Horizontal
    navInnerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    navInnerLayout.Padding        = UDim.new(0, 5)
    navInnerLayout.Parent         = navInner
 
    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size               = UDim2.new(0, 14, 1, 0)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text               = navIcon
    iconLbl.TextColor3         = T.textDim
    iconLbl.Font               = Enum.Font.Gotham
    iconLbl.TextSize           = 13
    iconLbl.TextXAlignment     = Enum.TextXAlignment.Center
    iconLbl.Parent             = navInner
 
    local textLbl = Instance.new("TextLabel")
    textLbl.Size               = UDim2.new(0, 0, 1, 0)
    textLbl.AutomaticSize      = Enum.AutomaticSize.X
    textLbl.BackgroundTransparency = 1
    textLbl.Text               = navLabel
    textLbl.TextColor3         = T.textDim
    textLbl.Font               = Enum.Font.Gotham
    textLbl.TextSize           = 12
    textLbl.TextXAlignment     = Enum.TextXAlignment.Left
    textLbl.Parent             = navInner
 
    local underline = Instance.new("Frame")
    underline.Size             = UDim2.new(1, -20, 0, 2)
    underline.Position         = UDim2.new(0, 10, 1, -2)
    underline.BackgroundColor3 = T.accent
    underline.BorderSizePixel  = 0
    underline.BackgroundTransparency = 1
    underline.Parent           = navBtn
    corner(1, underline)
 
    local tab = {
        navBtn=navBtn, underline=underline,
        iconLbl=iconLbl, textLbl=textLbl,
        page=page, scroll=scroll
    }
    table.insert(tabs, tab)
 
    navBtn.MouseEnter:Connect(function()
        if activeTab ~= tab then
            tween(textLbl, {TextColor3=T.text}, 0.1)
            tween(iconLbl, {TextColor3=T.text}, 0.1)
        end
    end)
    navBtn.MouseLeave:Connect(function()
        if activeTab ~= tab then
            tween(textLbl, {TextColor3=T.textDim}, 0.1)
            tween(iconLbl, {TextColor3=T.textDim}, 0.1)
        end
    end)
    navBtn.MouseButton1Click:Connect(function()
        if activeTab == tab then return end
        if activeTab then
            activeTab.page.Visible = false
            tween(activeTab.underline, {BackgroundTransparency=1},     0.15)
            tween(activeTab.textLbl,   {TextColor3=T.textDim},         0.15)
            tween(activeTab.iconLbl,   {TextColor3=T.textDim},         0.15)
        end
        activeTab = tab
        tab.page.Visible = true
        tween(tab.underline, {BackgroundTransparency=0},  0.15)
        tween(tab.textLbl,   {TextColor3=T.accent},       0.15)
        tween(tab.iconLbl,   {TextColor3=T.accent},       0.15)
    end)
 
    return scroll
end
 
