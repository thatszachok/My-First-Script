local function addSliderRow(scroll, labelText, minVal, maxVal, defaultVal, accent, onChange)
    accent = accent or T.accent
    local currentVal = defaultVal

    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1,0,0,54)
    row.BackgroundColor3 = T.bg1
    row.BorderSizePixel  = 0
    row.Parent           = scroll

    local nameLbl = lbl(labelText, 12, Enum.Font.Gotham, T.text, row)
    nameLbl.Size     = UDim2.new(1,-50,0,20)
    nameLbl.Position = UDim2.new(0,12,0,6)

    local valLbl = lbl(tostring(defaultVal), 12, Enum.Font.GothamBold, accent, row)
    valLbl.Size     = UDim2.new(0,40,0,20)
    valLbl.Position = UDim2.new(1,-50,0,6)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1,-20,0,4)
    track.Position         = UDim2.new(0,10,0,32)
    track.BackgroundColor3 = T.bg4
    track.BorderSizePixel  = 0
    track.Parent           = row
    corner(2, track)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((defaultVal-minVal)/(maxVal-minVal),0,1,0)
    fill.BackgroundColor3 = accent
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    corner(2, fill)

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0,12,0,12)
    thumb.AnchorPoint      = Vector2.new(0.5,0.5)
    thumb.Position         = UDim2.new((defaultVal-minVal)/(maxVal-minVal),0,0.5,0)
    thumb.BackgroundColor3 = T.white
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    corner(6, thumb)
    stroke(1, accent, thumb)

    local div = Instance.new("Frame")
    div.Size             = UDim2.new(1,0,0,1)
    div.Position         = UDim2.new(0,0,1,-1)
    div.BackgroundColor3 = T.border
    div.BackgroundTransparency = 0.5
    div.BorderSizePixel  = 0
    div.Parent           = row

    -- Drag logic
    local dragging = false
    local dragBtn = Instance.new("TextButton")
    dragBtn.Size             = UDim2.new(1,0,1,0)
    dragBtn.BackgroundTransparency = 1
    dragBtn.Text             = ""
    dragBtn.AutoButtonColor  = false
    dragBtn.Parent           = track

    local function setFromPos(absX)
        local trackAbsPos = track.AbsolutePosition.X
        local trackAbsSize = track.AbsoluteSize.X
        local ratio = math.clamp((absX - trackAbsPos) / trackAbsSize, 0, 1)
        local val = math.floor(minVal + ratio * (maxVal - minVal))
        currentVal = val
        tween(fill, {Size=UDim2.new(ratio,0,1,0)}, 0.05)
        tween(thumb, {Position=UDim2.new(ratio,0,0.5,0)}, 0.05)
        valLbl.Text = tostring(val)
        if onChange then onChange(val) end
    end

    dragBtn.MouseButton1Down:Connect(function(x,_)
        dragging = true; setFromPos(x)
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            setFromPos(inp.Position.X)
        end
    end)
end

