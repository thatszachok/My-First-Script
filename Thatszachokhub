    fill.BorderSizePixel  = 0
    fill.Parent           = trackBg
    corner(2, fill)
 
    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 14, 0, 14)
    thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
    thumb.Position         = UDim2.new((defaultVal-minVal)/(maxVal-minVal), 0, 0.5, 0)
    thumb.BackgroundColor3 = T.white
    thumb.BorderSizePixel  = 0
    thumb.Parent           = trackBg
    corner(7, thumb)
    stroke(2, accent, thumb)
 
    local sep = Instance.new("Frame")
    sep.Size             = UDim2.new(1, -16, 0, 1)
    sep.Position         = UDim2.new(0, 8, 1, -1)
    sep.BackgroundColor3 = T.border
    sep.BackgroundTransparency = 0.4
    sep.BorderSizePixel  = 0
    sep.Parent           = row
 
    local dragging = false
    local dragBtn = Instance.new("TextButton")
    dragBtn.Size             = UDim2.new(1, 0, 0, 20)
    dragBtn.Position         = UDim2.new(0, 0, 0, -8)
    dragBtn.BackgroundTransparency = 1
    dragBtn.Text             = ""
    dragBtn.AutoButtonColor  = false
    dragBtn.Parent           = trackBg
 
    local function setFromPos(absX)
        local ratio = math.clamp((absX - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local val   = math.floor(minVal + ratio * (maxVal - minVal))
        currentVal  = val
        tween(fill,  {Size=UDim2.new(ratio, 0, 1, 0)},       0.05)
        tween(thumb, {Position=UDim2.new(ratio, 0, 0.5, 0)},  0.05)
        valLbl.Text = tostring(val)
        if onChange then onChange(val) end
    end
 
    dragBtn.MouseButton1Down:Connect(function(x, _) dragging = true; setFromPos(x) end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            setFromPos(inp.Position.X)
        end
    end)
 
    -- return a function to re-tint the slider's accent color
    local function recolor(newAccent)
        fill.BackgroundColor3  = newAccent
        valLbl.TextColor3      = newAccent
        local s = thumb:FindFirstChildOfClass("UIStroke")
        if s then s.Color = newAccent end
    end
    return setFromPos, recolor
end
 
